{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.claude/settings.local.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "extraKnownMarketplaces": {
    "my-factory": {
      "source": {
        "source": "github",
        "repo": "JNico-rb/my-factory"
      }
    }
  },
  "enabledPlugins": {
    "sdd@my-factory": true
  }
}
